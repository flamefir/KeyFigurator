{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "0.2.6",
  "identifier": "com.orbit.config",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Orbit",
        "width": 1000, "height": 1100,
        "minWidth": 940, "minHeight": 700,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "flamefir",
    "shortDescription": "Configure the Lunar x MacroPad",
    "longDescription": "Orbit configures the Lunar x MacroPad over Raw HID: keymap, per-key and underglow LEDs, macros, host commands and the OLED screens.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
